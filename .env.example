# Supabase, from the project's API settings. Both are safe in the browser bundle;
# the anon key is protected by row level security, not by being secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server side only, used by the Netlify functions. Never prefixed with VITE_,
# because anything so prefixed is compiled into the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Nominatim asks every caller to identify itself. Set this to a real contact
# address before the boundary lookup is used against the live service.
NOMINATIM_USER_AGENT=
