# Supabase, from the project's API settings. Both are safe in the browser bundle;
# the anon key is protected by row level security, not by being secret.
#
# ANON_KEY takes either the legacy `anon` key or the newer publishable key, and
# SERVICE_ROLE_KEY either the legacy `service_role` key or the newer secret key.
# The names are the slots supabase-js documents, not the labels on the dashboard.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server side only, used by the Netlify functions. Never prefixed with VITE_,
# because anything so prefixed is compiled into the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter, for the one model call in this project. Server side only: the model
# writes drafts and this key must never reach the browser. Which model is used is
# in the code, not here - it is a product decision, not a secret.
OPENROUTER_API_KEY=

# Nominatim asks every caller to identify itself. Set this to a real contact
# address before the boundary lookup is used against the live service.
NOMINATIM_USER_AGENT=

# On Netlify, the functions read SUPABASE_URL and SUPABASE_ANON_KEY. Locally they
# fall back to the VITE_ ones above, so .env.local needs only what is listed here.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
